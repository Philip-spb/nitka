# Local development only. Match DATABASE_URL when changing container settings.
POSTGRES_USER=nitka
POSTGRES_PASSWORD=nitka
POSTGRES_DB=nitka
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://nitka:nitka@127.0.0.1:5433/nitka
INPUT_DIR=input_docs
# Tests create and drop their own randomly named schema, never application tables.
TEST_DATABASE_URL=postgresql+psycopg://nitka:nitka@127.0.0.1:5433/nitka
